
&{/axi/ethernet@ff0c0000} {
    phy-handle = <&caliptra_phy1>;
    mdio {
        #address-cells = <1>;
        #size-cells = <0>;
        caliptra_phy1: ethernet-phy@1 {
            #phy-cells = <1>;
            compatible = "ethernet-phy-id2000.a231";
            reg = <1>;
            ti,rx-internal-delay = <0xb>;
            ti,tx-internal-delay = <0xa>;
            ti,fifo-depth = <1>;
            ti,dp83867-rxctrl-strap-quirk;
        };
        caliptra_phy2: ethernet-phy@2 {
            #phy-cells = <1>;
            compatible = "ethernet-phy-id2000.a231";
            reg = <2>;
            ti,rx-internal-delay = <0xb>;
            ti,tx-internal-delay = <0xa>;
            ti,fifo-depth = <1>;
            ti,dp83867-rxctrl-strap-quirk;
        };
    };
};
&{/axi/ethernet@ff0d0000} { phy-handle = <&caliptra_phy2>; };
/* No PCIe/MSI consumer is enabled in this Caliptra design. */
&{/axi/interrupt-controller@f9000000/msi-controller@f9020000} { status = "disabled"; };
