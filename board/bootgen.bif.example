// Replace paths with matching outputs from one PetaLinux 2024.2 build.
// system.dtb must include the reviewed board/board-fix.dtsi correction.
the_ROM_image:
{
    image {
        { type=bootimage, file=inputs/caliptra_fpga.pdi }
        { type=bootloader, file=inputs/plm.elf }
        { core=psm, file=inputs/psmfw.elf }
    }
    image {
        id = 0x1c000000, name=apu_subsystem
        { type=raw, load=0x1000, file=inputs/system.dtb }
        { core=a72-0, exception_level=el-3, trustzone, file=inputs/bl31.elf }
        { core=a72-0, exception_level=el-2, file=inputs/u-boot.elf }
    }
}
